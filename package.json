{
  "name": "safe-everywhere",
  "version": "0.1.0",
  "description": "Deterministically mirror newly created Safe smart accounts across EVM chains.",
  "license": "MIT",
  "bin": {
    "safe-everywhere": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config/chains.example.yaml",
    ".env.example",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "tsx src/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src test",
    "prepack": "pnpm build",
    "start": "node dist/cli.js start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@safe-global/safe-deployments": "1.37.62",
    "pino": "10.3.1",
    "viem": "2.55.16",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
